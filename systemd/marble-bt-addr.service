[Unit]
Description=marble: give the WCN6855 Bluetooth controller a public address
Before=bluetooth.service
After=sys-subsystem-bluetooth-devices-hci0.device
Wants=sys-subsystem-bluetooth-devices-hci0.device

[Service]
Type=oneshot
ExecStart=/usr/libexec/marble-bt-addr
RemainAfterExit=yes

[Install]
WantedBy=bluetooth.target
